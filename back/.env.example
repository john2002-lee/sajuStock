# --- 앱 ---
DEBUG=false
LOG_LEVEL=INFO
# 리스트 값은 JSON 배열로 기입한다 (pydantic-settings가 JSON으로 파싱).
CORS_ORIGINS=["http://localhost:3000"]

# --- DB ---
# **Postgres 전용이다.** SQLite 는 더 이상 지원하지 않는다 — 개발과 운영이 다른
# 방언 위에서 돌면 차이가 운영에서만 드러난다(실제로 `ORDER BY ... DESC` 의 NULL
# 위치가 정반대라 등락률 랭킹 모집단이 조용히 뒤집혔다). sqlite:// 를 넣으면 기동
# 시점에 설정 검증이 막는다.
#
# Supabase 대시보드 > Project Settings > Database > Connection string 의 URI 를
# **그대로** 붙여넣는다 (sslmode·postgres:// 접두는 앱이 정규화한다).
#
#   ⚠ "Direct connection"(db.<ref>.supabase.co:5432)은 최신 프로젝트에 없다.
#     그 호스트는 DNS 조차 해석되지 않으므로 반드시 아래 둘 중 하나를 쓴다.
#
#   Transaction pooler (6543) — 서버리스·짧은 요청에 권장. 프리페어드는 앱이 끈다
DATABASE_URL=postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:6543/postgres
#   Session pooler (5432)     — 긴 트랜잭션·마이그레이션에 안전
#   DATABASE_URL=postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
#   로컬 Postgres 로 개발할 때 (pgvector 확장이 있어야 RAG 가 돈다)
#   DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres
#
# ⚠ **front/.env.local 의 AUTH_DATABASE_URL 과 같은 DB 여야 한다.** 프런트의 NextAuth
#   어댑터가 쓰는 users 와 백엔드의 watchlist_items·investor_profiles 가 갈리면,
#   `services/orphan_service` 가 로그인 사용자의 행을 전부 "소유자 없음" 으로 읽는다.
DB_ECHO=false
# 스키마는 alembic 이 관리한다 — `uv run alembic upgrade head`.
# true 로 두면 create_all 이 마이그레이션과 별개로 테이블을 만들어 이력이 어긋난다.
#
# **코드 기본값도 false 다.** 이 줄을 지워도 안전한 쪽으로 떨어진다. 그리고 true 로
# 두더라도 `alembic_version` 이 있는 DB 에서는 기동을 거부한다 — 스키마의 출처가
# 둘이 되는 상태를 조용히 만들지 않기 위해서다.
DB_CREATE_ALL_ON_STARTUP=false

# --- 테스트 DB (필수) ---
# **비워 두면 테스트가 아예 시작되지 않는다.** 예전에는 인메모리 SQLite 로 폴백했는데,
# 그 폴백이 정확히 막으려던 사고를 냈다 — `ORDER BY ... DESC` 의 NULL 위치가 Postgres 와
# 정반대라, 테스트가 전부 초록인 채로 운영 랭킹이 조용히 뒤집혀 있었다.
#
# 지켜야 할 것이 둘이다.
#
#   ① **반드시 별도 프로젝트.** 하네스가 시작할 때 drop_all 로 스키마를 새로 만든다.
#      DATABASE_URL 과 같은 DB 를 가리키면 conftest 가 즉시 멈추게 해 뒀다.
#   ② **세션 풀러(5432)를 쓴다.** 테스트 하나가 커넥션 하나를 붙잡고 트랜잭션을
#      열어 두므로, 트랜잭션 풀러(6543)는 그 사이 백엔드가 바뀌어 맞지 않는다.
#      direct connection(db.<ref>.supabase.co)은 IPv4 가 없어 대개 연결되지 않는다.
TEST_DATABASE_URL=postgresql://postgres.<ref>:<PW>@aws-0-<region>.pooler.supabase.com:5432/postgres

# --- 외부 HTTP (KRX / KIND) ---
HTTP_TIMEOUT_SECONDS=20

# --- 상장사 목록 ---
LISTED_COMPANY_MIN_COUNT=100
SUGGESTION_CANDIDATE_LIMIT=500

# --- 재무·밸류에이션 ---
# 종목당 캐시 수명(초). 미스 한 번이 1~2초라 요청마다 조회할 수 없고,
# PER/PBR 은 주가를 따라 움직여 하루 캐시도 곤란하다.
STOCK_FUNDAMENTALS_TTL_SECONDS=900
STOCK_FUNDAMENTALS_CACHE_SIZE=512

# --- AI 판단 캐시·상한·자물쇠 ---
# 이 프로젝트에서 유일하게 돈이 나가는 경로(종목당 LLM 4회)의 수도꼭지다.
# 이 시간 안에는 같은 종목을 다시 물어도 뉴스 조회조차 없이 캐시를 낸다.
# 만료 뒤에는 뉴스 지문만 비교해, 기사가 그대로면 LLM 없이 수명을 연장한다.
ADVICE_CACHE_TTL_SECONDS=600
ADVICE_CACHE_SIZE=256
# 동시에 돌릴 수 있는 분석 수. 초과 요청은 429다(대기가 아니라 거절).
ADVICE_MAX_CONCURRENT=4
# 판단 한 건의 전체 시간 상한. 넘기면 실패가 아니라 규칙 기반 판단으로 착지한다.
ADVICE_BUDGET_SECONDS=90
# SSE 주석 프레임 간격(초). 조용한 연결을 중간 프록시가 끊는 것을 막는다.
ADVICE_HEARTBEAT_SECONDS=10
# AI 판단 엔드포인트 2개를 여는 공유 비밀키. 프런트 BFF 만 알고 브라우저에는 안 나간다.
# 프런트의 front/.env.local 에 ADVICE_API_KEY 로 **같은 값**을 넣어야 한다.
#   생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 비워 두면 인증이 꺼지고(로컬 개발용) 기동 시 경고가 뜬다 — 외부에 노출할 때는 반드시 채운다.
ADVICE_API_KEY=

# --- 관리자 ---
# 관리자 엔드포인트(/api/v1/admin/*)를 여는 공유 비밀키.
# front/.env.local 의 ADMIN_API_KEY 와 **같은 값**이어야 한다.
#   생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ⚠ ADVICE_API_KEY 와 **다른 값**으로 둔다. AI 키가 새면 남이 우리 토큰을 태우지만,
#   관리자 키가 새면 남이 자기 계정에 관리자 권한을 준다. 두 값을 하나로 두면
#   매 AI 요청에 실려 나가는 키가 곧 관리자 키가 된다.
#
# ⚠ **비어 있으면 관리자 API 가 닫힌다** (ADVICE_API_KEY 와 정반대다).
#   설정을 빠뜨린 서버가 권한 부여 API 를 공개하는 것보다, 관리자 화면이
#   안 열리는 편이 비교할 수 없이 낫다.
ADMIN_API_KEY=

# --- LLM (Google Gemini) ---
# 비워두면 SDK가 GOOGLE_API_KEY / GEMINI_API_KEY 환경 변수를 읽는다.
# AI Studio(aistudio.google.com/apikey) 에서 발급한다.
GEMINI_API_KEY=
# gemini-2.5/3 정식 모델을 쓴다. 이 계열만 thinking(LLM_EFFORT)을 받는다.
# `-latest` 별칭은 thinkingConfig 와 함께 400 이 날 수 있어 피한다.
# 그런 모델을 넣어도 앱이 thinking 을 빼고 보내므로 동작은 한다 — LLM_EFFORT 만 무시된다.
GEMINI_MODEL=gemini-2.5-flash
# 생각 토큰도 이 상한을 함께 먹는다. 낮추면 본문이 빈 채로 MAX_TOKENS 로 끝날 수 있다.
LLM_MAX_TOKENS=16000
# low | medium | high | xhigh | max — Gemini 의 '생각 토큰 예산'으로 환산된다
# (low=0 → 생각 끔, max=-1 → 모델이 알아서). 매핑은 integrations/llm.py 에 있다.
LLM_EFFORT=medium
# 호출 **하나**의 상한. 판단 전체는 ADVICE_BUDGET_SECONDS 가 맡는다.
# 재시도가 이 값을 곱한다 — 300/2 조합의 최악값은 900초였다.
LLM_TIMEOUT_SECONDS=45
# 0 이다. 재시도는 이 파이프라인에서 결과를 더 나쁘게 만든다 (config.py 주석).
LLM_MAX_RETRIES=0

# --- RAG (검색 증강 · Supabase pgvector) ---
# **대개 비워 둔다.** DATABASE_URL 을 그대로 벡터 저장소로 쓴다 — 같은 Supabase
# 인스턴스가 앱 테이블과 pgvector 테이블을 함께 담는다. 두 곳에 같은 주소를 적어
# 두면 한쪽만 바꿔 어긋난다.
#
# 채우는 경우는 하나: **벡터만 다른 인스턴스로 빼고 싶을 때.** 있으면 이쪽이 이긴다.
# 최초 1회 `uv run python -m scripts.verify_rag` 가 확장·테이블·인덱스까지 만든다.
VECTOR_DATABASE_URL=
EMBEDDING_MODEL=gemini-embedding-001
# 테이블의 vector(N) 이 이 값으로 만들어진다. 적재 후 바꾸면 차원이 어긋난다.
# gemini-embedding-001 은 출력 차원을 지정할 수 있어(MRL) 이 값을 그대로 따른다 —
# 덕분에 OpenAI(1536) 에서 넘어올 때 색인을 다시 만들지 않아도 됐다.
EMBEDDING_DIMENSIONS=1536
RAG_CHUNK_CHARS=900
RAG_CHUNK_OVERLAP=150
# 검색기별 후보 수 → 융합 후 상위 몇 건을 프롬프트에 넣을지
RAG_CANDIDATE_K=24
RAG_TOP_K=6
# 이보다 오래된 문서는 검색하지 않는다.
RAG_RECENCY_DAYS=120
# 판단 요청 때 새 뉴스를 색인할지. 끄면 스크립트·배치로만 채운다.
RAG_INGEST_ON_ADVICE=true
# 색인+검색 전체 예산(초). 넘기면 문서 없이 판단을 진행한다.
RAG_TIMEOUT_SECONDS=15

# --- 시가총액 배치 (자동완성 랭킹 가중치) ---
# 1차 소스 pykrx 는 KRX 데이터포털(data.krx.co.kr) 로그인을 요구한다.
# **API 키가 아니라 회원 아이디·비밀번호**다 — 가입한 계정을 그대로 적는다.
#
# 채우면 전 종목(2,700+) 시총을 한 번에 받아오고, 비워두면 yfinance 폴백(종목당
# 1회 호출)으로 내려간다. 어느 쪽인지는 기동 로그가 알려 준다.
#
# 특수문자(`!` 등)는 이스케이프도 따옴표도 필요 없다 — `.env` 는 셸이 아니다.
KRX_ID=
KRX_PW=
# yfinance 폴백이 1회 실행에서 채우는 종목 수 상한.
MARKET_CAP_BATCH_LIMIT=400

# --- 종목 스냅샷 배치 (오늘의 일정 + 스크리너 지표) ---
# 하루 1회 배치가 한 번에 물어볼 종목 수. 종목당 yfinance 2회(info ~0.5초 +
# 밸류에이션 ~0.2초) · 동시 8스레드라 200이면 20초쯤이다. 전 종목(2,700+)은
# 며칠에 걸쳐 채워진다.
#
# 일정(실적발표·배당락)과 지표(시총·PER·PBR·ROE·배당수익률)를 **한 배치가 함께**
# 채운다. 나누면 같은 종목에 get_info() 를 두 번 치게 되고, 실제로 그것 때문에
# 야후가 전 종목 요청을 거부한 적이 있다.
#
# 시총 배치와 다른 점: **일정은 만료된다.** 실적발표일이 지나면 그 값은 과거를
# 가리키므로, "아직 없는 종목" 이 아니라 "가장 오래 안 물어본 종목" 부터 채운다.
SNAPSHOT_BATCH_LIMIT=200
# 홈 화면이 기본으로 보는 창(일). 넓히면 '오늘의 일정'이 '이번 분기 일정'이 된다.
CALENDAR_DEFAULT_DAYS=7
# 조건 검색 한 페이지 종목 수.
SCREENER_PAGE_SIZE=50

# --- 분석 (Amplitude Agent Analytics) ---
#
# AI 판단·사주 리포트의 LLM 호출을 Agent Analytics 로 보낸다. **비워 두면 계측이
# 통째로 꺼진다** — 실패가 아니라 설계다. 로컬 개발과 테스트가 네트워크 없이
# 돌아야 하고, 분석이 안 붙었다고 판단이 멈추면 안 된다. 꺼져 있으면 기동 로그가
# 한 줄로 말한다.
#
# 본문 수집 정책이 두 서비스에서 다르다 (`app/integrations/amplitude.py`):
#   주식 — 프롬프트·응답 본문까지 (+ 이메일·전화 등 PII 마스킹)
#   사주 — **본문 없음.** 생년월일시가 프롬프트에 실려 있고 그것은 민감정보다.
#          토큰·지연·비용만 나간다.
AMPLITUDE_AI_API_KEY=
