# 사주 엔드포인트만 확인할 때 쓰는 최소 설정.
#
# `/saju/chart` 와 `/saju/places` 는 **DB 도 LLM 도 쓰지 않는다** — 순수 계산이라
# 아래 값들만으로 돈다. `/saju/report` 만 GEMINI_API_KEY 를 필요로 하고, 없으면
# 규칙 기반 간이 리포트(`source="fallback"`)로 내려간다.
#
# 전체 기능(종목·관심종목·AI 판단)을 쓰려면 `.env.example` 을 보고 `.env` 를 채운다.

# 기동 워밍업을 끈다. 켜져 있으면 KRX 수집과 등락률 스캔이 배경에서 도는데,
# 사주만 확인할 때는 불필요하고 로그만 시끄럽다.
SEED_LISTED_COMPANIES_ON_STARTUP=false
WARM_MARKET_MOVERS_ON_STARTUP=false

# 없으면 기본값(로컬 Postgres)을 쓴다. 사주 경로는 연결을 열지 않으므로
# 실제로 뜨지 않아도 된다.
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/postgres

CORS_ORIGINS=["http://localhost:3000"]
