# 백엔드 주소. **`/api/v1` 까지 포함한다** — 서비스 코드는 "/stocks/history" 처럼
# prefix 없는 경로만 넘긴다.
#
# 포트는 8000 이 표준이다 (back/README · uv run fastapi dev 기본값).
# 다른 포트로 띄웠다면 여기도 같이 바꿔야 한다 — 어긋나면 종목 상세가
# network_error 로 떨어진다.
STOCK_API_BASE_URL=http://localhost:8000/api/v1

# 1 이면 백엔드 없이 목 데이터로 화면을 그린다. 평소에는 비워 둔다.
USE_MOCK=

# 조회 타임아웃(ms). 생략하면 각각 20초 / 300초.
# STOCK_API_TIMEOUT_MS=20000
# AI 판단 스트림의 최후 안전판. 백엔드 ADVICE_BUDGET_SECONDS(90) 보다 **넉넉히**
# 커야 한다 — 짧으면 규칙 기반 착지가 도착 직전에 잘린다.
# STOCK_AI_TIMEOUT_MS=120000

# AI 판단 엔드포인트를 여는 공유 비밀키. back/.env 의 ADVICE_API_KEY 와 **같은 값**이어야 한다.
# BFF 라우트(app/api/stocks/advice)만 읽고 브라우저에는 나가지 않는다.
# NEXT_PUBLIC_ 을 붙이면 클라이언트 번들에 인라인되어 자물쇠가 무의미해진다 — 절대 붙이지 말 것.
# 양쪽 다 비워 두면 인증이 꺼진다 (로컬 개발 기본값).
ADVICE_API_KEY=

# --- 관리자 ---
#
# **첫 관리자를 정하는 씨앗이자, 잠기지 않기 위한 복구용 마스터키.**
# 여기 적힌 이메일은 DB 의 users.role 과 무관하게 항상 관리자로 인정된다 —
# 실수로 자기 권한을 회수해도 서비스가 잠기지 않는 이유가 이것이다. 쉼표로 여럿 적는다.
# 로그인한 이메일과 **대소문자 무관하게** 비교한다 (구글이 주는 대소문자가 다를 수 있다).
#
# 이 값과 ADMIN_API_KEY 둘 다 비어 있으면 제호에 '관리자' 버튼이 나타나지 않는다.
ADMIN_EMAILS=

# 백엔드 관리자 API(/api/v1/admin/*)를 여는 공유 비밀키.
# back/.env 의 ADMIN_API_KEY 와 **같은 값**이어야 한다 — 없으면 화면은 열리고 API 가
# 503 을 준다 (그 안내를 AdminUnavailable 이 상태 코드별로 말한다).
#   생성: python -c "import secrets; print(secrets.token_urlsafe(32))"
#
# ⚠ ADVICE_API_KEY 와 **다른 값**으로 둔다 (근거는 back/.env.example).
# ⚠ 이 키는 인증이 아니라 2차 방어선이다. "누가 관리자인가" 는 세션과 users.role 을
#   보는 프런트가 판단한다 (src/lib/auth/admin.ts).
ADMIN_API_KEY=

# --- 로그인 (NextAuth v5 / Auth.js) ---
#
# **전부 비워 두면 로그인이 꺼진다.** 그때도 서비스는 다 쓸 수 있고, 관심종목은
# 익명 신원(httpOnly 쿠키)으로 동작한다. 로그인 버튼과 /login 폼은 나타나지 않는다 —
# 누르면 깨지는 버튼을 두지 않기 위해서다.
#
# 키를 넣으면 코드를 고치지 않아도 그 수단이 켜진다.
#
# ⚠ 세션은 **JWT** 다. 비밀번호 로그인(Credentials)이 그것만 지원하기 때문이고, 그래서
#   sessions 테이블은 더 이상 쓰이지 않는다 (auth.ts). 예전에 database 전략으로 만든
#   세션 쿠키(authjs.session-token)가 남아 있으면 **접속하는 호스트마다** 한 번씩
#   지우는 편이 깔끔하다 (쿠키는 호스트별로 따로 산다).

# 세션 서명·암호화 키. 로컬 개발용 아무 값이나 넣으면 되고, 배포에서는 별도로 생성해 주입한다.
#   npx auth secret
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# **이 값을 바꾸면 기존 세션이 전부 무효가 된다.**
AUTH_SECRET=

# 호스트 검사를 건너뛴다. **리버스 프록시 뒤나 비표준 포트에서 필요할 때만 켠다.**
# NextAuth v5 는 프로덕션 빌드에서 요청 호스트를 검사하는데, 프록시를 거치면 실제
# 도메인과 달라져 `/api/auth/*` 가 전부 500(UntrustedHost)이 된다 — 화면은 멀쩡한데
# 로그인만 안 되는 상태라 원인을 찾기 어렵다. Vercel 은 자동으로 처리하므로 불필요.
#
# **기본값을 true 로 복사·배포하지 않는다.** Host 헤더 검사를 끄면 콜백/인증
# URL이 요청의 Host 헤더로 구성될 수 있다 — Host 를 신뢰할 수 있는 프록시(고정
# 도메인만 통과시키는) 뒤일 때만 켜고, 가능하면 AUTH_URL 을 명시적으로 고정한다.
AUTH_TRUST_HOST=

# 사용자·계정·가입 인증 토큰이 저장될 Postgres. **비밀번호 해시(users.password_hash)도
# 여기 산다** — 이 값이 있어야 이메일/비밀번호 로그인이 켜진다 (auth.ts 의 hasDatabase).
#
# **back/.env 의 DATABASE_URL 과 같은 Supabase 프로젝트여야 한다.** 프런트는 그 파일을
# 못 읽으므로 여기에도 적어야 하고, 두 곳이 갈라지면 조용히 망가진다 — 백엔드가 여기
# 쓰인 사용자를 못 찾고, back 의 services/orphan_service 는 그것을 "소유자 없는 행" 으로
# 읽어 로그인 사용자의 관심종목을 지울 후보로 센다. 실제로 두 프로젝트로 갈라져 있던
# 적이 있고, orphan_service 의 안전장치(users 를 못 읽으면 아무것도 안 한다)가 막았다.
#
# 비워 두면 폴백은 없다 — 프런트에는 DATABASE_URL 이 없으므로 로그인이 켜진 순간
# lib/auth/pool.ts 가 예외를 던진다. "비우면 알아서 백엔드 값을 쓴다" 가 아니다.
#
# `postgresql+asyncpg://` 로 적어도 앱이 `postgresql://` 로 바꿔 준다 (lib/auth/pool.ts).
AUTH_DATABASE_URL=

# 구글 OAuth — https://console.cloud.google.com/apis/credentials
#   1. **OAuth 동의 화면을 먼저 만든다** (User Type: External · 상태: Testing).
#      안 만들면 클라이언트 ID 생성 자체가 막힌다. 스코프는 기본(email·profile)이면 된다.
#   2. **테스트 사용자에 본인 구글 계정을 추가한다.** Testing 상태에서 여기 없는 계정으로
#      로그인하면 403 access_denied 가 나는데, 키가 틀린 것처럼 보인다.
#   3. 사용자 인증 정보 만들기 > OAuth 클라이언트 ID > 웹 애플리케이션
#   4. 승인된 리디렉션 URI 에 아래를 등록한다 (배포 시 도메인도 함께)
#        http://localhost:3000/api/auth/callback/google
#
#   ⚠ 구글은 http 리디렉션을 localhost / 127.0.0.1 에만 허용한다. 사설 IP
#     (http://192.168.x.x:3000)는 등록되지 않으므로 **LAN 주소에서는 구글 로그인이
#     성립하지 않는다.** 테스트는 localhost 로 한다. 다른 기기에서도 써야 한다면
#     https 도메인(개발용 터널 등)을 얻어 등록하고 AUTH_URL 을 그 주소로 고정한다.
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# 가입 인증 메일 — SMTP URL 을 nodemailer 가 그대로 받는다.
#
# **로그인 수단이 아니다.** 이메일 매직링크는 2026-08-18 에 걷어냈다. 지금 이 설정은
# 개발자 모드 회원가입(/signup)이 보내는 인증 링크에만 쓰인다 (lib/auth/signup.ts).
# 비워 두어도 로그인은 멀쩡하고, 가입 시 인증 URL 이 서버 콘솔에 찍힌다.
# Resend 예: smtp://resend:<API_KEY>@smtp.resend.com:587
# Gmail 앱 비밀번호 예: smtp://<계정>@gmail.com:<앱비밀번호>@smtp.gmail.com:587
# 키에 @ · / 같은 문자가 있으면 URL 인코딩한다 (안 하면 호스트 파싱이 깨진다).
EMAIL_SERVER=
# ⚠ 그 공급자에서 **발송이 허용된 주소**여야 한다. 아무 주소나 적으면 SMTP 는 붙고
#   발송만 거부되어, 화면에는 "인증 메일을 보냈습니다" 가 뜨고 메일은 오지 않는다.
#   도메인이 아직 없으면 onboarding@resend.dev 로 시작한다 (가입 본인에게만 발송된다).
EMAIL_FROM=
